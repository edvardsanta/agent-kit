#!/usr/bin/env python3
"""agent-kit: standardize AGENTS.md / CLAUDE.md across projects.

`agent-kit init` (also installed as `agent-init`):

Deterministic part (idempotent): managed rules block, CLAUDE.md import, .gitignore,
no-coauthor setting for Claude Code, ai-memory routing block.
Generative part (optional): claude or codex fills the project-specific sections.

`agent-kit sync`: re-apply deterministic rules to existing agent-kit repositories.
`agent-kit rules`: show, seed or update the rules used for the managed block.
`agent-kit procedures`: initialize and inspect shared project procedures.
"""
import argparse
import difflib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

KIT = Path(__file__).resolve().parent.parent
VERSION = "0.2.0"
END = "<!-- agent-kit:end -->"
START_RE = re.compile(r"<!-- agent-kit:start(?P<attrs>(?: [\w-]+=[\w-]+)*) -->")
AI_MEMORY_START = "<!-- ai-memory:start -->"
MARKER_RE = re.compile(r"<!--\s*(agent-kit|ai-memory):")
SUSPICIOUS_RE = re.compile(
    r"https?://|\b(curl|wget|sudo|eval|base64|chmod|chown|ssh|scp|nc)\b|\|\s*(ba|z)?sh\b"
    r"|hooks?\b|allowedTools|permission|settings(\.local)?\.json|\.mcp\.json"
    r"|ignore (all |any )?(previous|prior|above)|api[_ -]?key|token|secret|password", re.I)
LANGS = {"pt": "português do Brasil", "en": "English"}
SKIP_DIRS = {".worktrees", "node_modules", ".venv", "venv", "vendor", "target", "build", "dist"}
PROJECT_RULE_HEADINGS = {"en": "## Project rules\n", "pt": "## Regras do projeto\n"}
PROCEDURES_README = {
    "en": """# Project procedures

Reusable project workflows shared by users and all agents.

- Keep one procedure per Markdown file.
- Record prerequisites, ordered steps, verification and rollback where relevant.
- Do not store secrets, credentials or disposable scratch work here.
- Create or update procedures only when the user explicitly asks to preserve them.
""",
    "pt": """# Procedimentos do projeto

Fluxos reutilizáveis do projeto, compartilhados por usuários e todos os agentes.

- Mantenha um procedimento por arquivo Markdown.
- Registre pré-requisitos, passos ordenados, verificação e reversão quando relevante.
- Não guarde segredos, credenciais nem rascunhos descartáveis aqui.
- Crie ou atualize procedimentos somente quando o usuário pedir explicitamente para preservá-los.
""",
}
PROCEDURE_TEMPLATE = {
    "en": """# {title}

## When to use

Describe when this procedure applies.

## Prerequisites

- List required access, tools and state.

## Steps

1. Describe the first action.

## Verification

- Describe how to confirm success.

## Rollback

- Describe how to recover when relevant.
""",
    "pt": """# {title}

## Quando usar

Descreva quando este procedimento se aplica.

## Pré-requisitos

- Liste acessos, ferramentas e estado necessários.

## Passos

1. Descreva a primeira ação.

## Verificação

- Descreva como confirmar o sucesso.

## Reversão

- Descreva como recuperar quando relevante.
""",
}

CLAUDE_MD = """@AGENTS.md

## Claude Code notes

- `AGENTS.md` is canonical; edit rules there, not here. The ai-memory routing block lives
  in `AGENTS.md` and is loaded through the import above (do not add a second copy here).
"""


class InitError(Exception):
    pass


def log(msg):
    print(f"[agent-kit] {msg}")


class Changes:
    """Pending file writes, so the same plan can be written, diffed or checked."""

    def __init__(self, repo):
        self.repo = repo
        self.pending = {}

    def read(self, path):
        if path in self.pending:
            return self.pending[path][0]
        return path.read_text() if path.exists() else None

    def write(self, path, text, msg):
        if self.read(path) != text:
            msgs = self.pending.get(path, (None, []))[1]
            self.pending[path] = (text, msgs + [msg])

    def rel(self, path):
        return os.path.relpath(path, self.repo)

    def apply(self):
        for path, (text, msgs) in self.pending.items():
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(text)
            for msg in msgs:
                log(msg)

    def diff(self):
        for path, (text, _) in self.pending.items():
            old = path.read_text() if path.exists() else ""
            rel = self.rel(path)
            sys.stdout.writelines(difflib.unified_diff(
                old.splitlines(True), text.splitlines(True), f"a/{rel}", f"b/{rel}"))


def user_rules_dir():
    """Personal rules live outside the checkout, so `git pull` never conflicts with them."""
    env = os.environ.get("AGENT_KIT_RULES")
    if env:
        return Path(env).expanduser()
    return Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "agent-kit" / "rules"


def rules_file(lang):
    """The user's rules file for `lang` if there is one, else the bundled default."""
    f = user_rules_dir() / f"{lang}.md"
    return f if f.exists() else KIT / "rules" / f"{lang}.md"


def project_rules_file(repo, lang):
    return repo / ".agent-kit" / "rules" / f"{lang}.md"


def procedures_dir(repo):
    directory = repo / ".agent-kit" / "procedures"
    try:
        directory.resolve().relative_to(repo.resolve())
    except ValueError:
        raise InitError(f"{directory} resolves outside the repository")
    return directory


def seed_rules():
    """Copy bundled rules that are missing from the user rules dir; never overwrite."""
    d = user_rules_dir()
    for lang in LANGS:
        f = d / f"{lang}.md"
        if not f.exists():
            d.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(KIT / "rules" / f"{lang}.md", f)
            log(f"rules: created {f}")


def seed_project_rules(repo):
    created = []
    for lang, heading in PROJECT_RULE_HEADINGS.items():
        path = project_rules_file(repo, lang)
        if not path.exists():
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(heading)
            log(f"rules: created {path}")
            created.append(path)
    return created


def render_block(docs_lang, git_lang, chat_lang=None, repo=None):
    chat_lang = chat_lang or docs_lang
    body = rules_file(docs_lang).read_text()
    supports_split_languages = "{{CHAT_LANG_NAME}}" in body and "{{DOCS_LANG_NAME}}" in body
    if repo:
        project_file = project_rules_file(repo, docs_lang)
        if project_file.exists():
            project_body = project_file.read_text().strip()
            if MARKER_RE.search(project_body):
                raise InitError(f"{project_file}: managed-block markers are not allowed in project rules")
            if project_body:
                body = body.rstrip() + "\n\n" + project_body + "\n"
    if chat_lang != docs_lang and not supports_split_languages:
        raise InitError(
            f"{rules_file(docs_lang)} uses the old language template; add "
            "{{CHAT_LANG_NAME}} and {{DOCS_LANG_NAME}} before choosing different chat and docs languages")
    replacements = {
        "{{LANG_NAME}}": LANGS[docs_lang],  # compatibility with existing personal templates
        "{{CHAT_LANG_NAME}}": LANGS[chat_lang],
        "{{DOCS_LANG_NAME}}": LANGS[docs_lang],
        "{{GIT_LANG_NAME}}": LANGS[git_lang],
    }
    for placeholder, value in replacements.items():
        body = body.replace(placeholder, value)
    marker = f"<!-- agent-kit:start docs-lang={docs_lang} chat-lang={chat_lang} git-lang={git_lang} -->"
    return f"{marker}\n{body.rstrip()}\n{END}\n"


def saved_languages(repo):
    f = repo / "AGENTS.md"
    m = START_RE.search(f.read_text()) if f.exists() else None
    if not m:
        return None, None, None
    attrs = dict(re.findall(r"([\w-]+)=([\w-]+)", m.group("attrs")))
    # Old markers used lang= for both conversation and documentation.
    docs_lang = attrs.get("docs-lang") or attrs.get("lang")
    chat_lang = attrs.get("chat-lang") or attrs.get("lang")
    return docs_lang, chat_lang, attrs.get("git-lang")


def saved_langs(repo):
    """Compatibility helper: the historical API returned documentation and Git languages."""
    docs_lang, _, git_lang = saved_languages(repo)
    return docs_lang, git_lang


def has_marker(repo):
    f = repo / "AGENTS.md"
    return f.exists() and START_RE.search(f.read_text()) is not None


def upsert_block(text, block):
    """Return `text` with the managed block inserted or replaced."""
    if text is None:
        return f"# AGENTS.md\n\n{block}"
    pattern = re.compile(START_RE.pattern + r".*?" + re.escape(END) + r"\n?", re.S)
    if pattern.search(text):
        return pattern.sub(lambda _: block, text, count=1)
    # keep the existing title on top, insert the block right after it
    m = re.match(r"(#[^\n]*\n+)", text)
    head, rest = (m.group(1), text[m.end():]) if m else ("", text)
    return f"{head}{block}\n{rest}"


def git_common_dir(repo):
    r = subprocess.run(["git", "rev-parse", "--git-common-dir"], cwd=repo, capture_output=True, text=True)
    if r.returncode != 0:
        raise InitError(f"{repo}: git rev-parse failed: {r.stderr.strip()}")
    return (repo / r.stdout.strip()).resolve()


def ensure_ignored(ch, entry, tracked):
    """Default to .git/info/exclude so upstream clones get no diff; --tracked edits .gitignore."""
    tracked_gi = ch.repo / ".gitignore"
    gi = tracked_gi if tracked else git_common_dir(ch.repo) / "info" / "exclude"
    # an entry already in the tracked .gitignore (an earlier --tracked run) also counts
    for f in {gi, tracked_gi}:
        lines = (ch.read(f) or "").splitlines()
        if entry in lines or entry.rstrip("/") in lines:
            return
    lines = (ch.read(gi) or "").splitlines()
    ch.write(gi, "\n".join(lines + [entry]) + "\n", f"{gi.name}: added {entry}")


def ensure_agents_md(ch, block):
    f = ch.repo / "AGENTS.md"
    old = ch.read(f)
    ch.write(f, upsert_block(old, block), f"AGENTS.md: {'created' if old is None else 'updated'}")


def ensure_claude_md(ch, keep_existing=False):
    cm = ch.repo / "CLAUDE.md"
    text = ch.read(cm)
    if text is None:
        ch.write(cm, CLAUDE_MD, "CLAUDE.md: created (imports AGENTS.md)")
    elif "@AGENTS.md" not in text and not keep_existing:
        raise InitError(
            "CLAUDE.md exists but does not import AGENTS.md; use --migrate-claude "
            "or --keep-claude")


def ensure_no_coauthor(ch):
    # The Claude Code harness injects its own Co-Authored-By instruction; this setting is what turns it off.
    f = ch.repo / ".claude" / "settings.local.json"
    text = ch.read(f)
    try:
        data = json.loads(text) if text else {}
    except json.JSONDecodeError as e:
        raise InitError(f"{ch.rel(f)}: invalid JSON ({e}); fix it and run again")
    if not isinstance(data, dict) or not isinstance(data.get("attribution", {}), dict):
        raise InitError(f"{ch.rel(f)}: expected an object with an `attribution` object; fix it and run again")
    ensure_ignored(ch, ".claude/settings.local.json", False)
    attribution = data.setdefault("attribution", {})
    if attribution.get("commit") == "" and attribution.get("pr") == "":
        return
    attribution.update(commit="", pr="")
    ch.write(f, json.dumps(data, indent=2) + "\n", ".claude/settings.local.json: attribution disabled")


def plan(repo, docs_lang, git_lang, chat_lang=None, tracked=False, hide_agent_files=False,
         migrate=False, keep_claude=False):
    ch = Changes(repo)
    ensure_agents_md(ch, render_block(docs_lang, git_lang, chat_lang, repo))
    if not migrate:
        ensure_claude_md(ch, keep_claude)
    ensure_ignored(ch, ".worktrees/", tracked)
    if hide_agent_files:
        for name in ("AGENTS.md", "CLAUDE.md", "AGENTS.md.bak-*", ".agents/"):
            ensure_ignored(ch, name, False)
    ensure_no_coauthor(ch)
    return ch


def install_ai_memory(repo, full, skills):
    if not shutil.which("ai-memory"):
        log("WARNING: ai-memory not found in PATH; routing block skipped")
        return
    cmd = ["ai-memory", "install-instructions", "--target", "AGENTS.md"]
    if not full:
        cmd.append("--compact")
    if not skills:
        cmd.append("--no-skills")
    r = subprocess.run(cmd, cwd=repo, capture_output=True, text=True)
    log("ai-memory: routing block " + ("installed" if r.returncode == 0 else f"FAILED\n{r.stderr.strip()}"))


def resolve_exe(name):
    exe = shutil.which(name)
    if not exe:
        raise InitError(f"{name} not found in PATH")
    # asdf shims resolve the version from the cwd's .tool-versions, which the target repo may pin differently
    if "/.asdf/shims/" in exe:
        real = subprocess.run(["asdf", "which", name], cwd=Path.home(), capture_output=True, text=True).stdout.strip()
        exe = real or exe
    return exe


def select_agent(requested):
    """Resolve auto-selection before any repository writes happen."""
    if requested == "none":
        return "none"
    if requested in ("claude", "codex"):
        if not shutil.which(requested):
            raise InitError(
                f"{requested} was not found; no files were changed. Install it, choose another "
                "agent, or use --agent none")
        resolve_exe(requested)
        return requested
    for candidate in ("claude", "codex"):
        if shutil.which(candidate):
            return candidate
    raise InitError(
        "no supported agent found; no files were changed. Install Claude or Codex, "
        "choose --agent explicitly, or use --agent none")


def ask_agent(agent, prompt):
    """Run the agent without tools in an empty dir (no project instructions) and return its answer."""
    with tempfile.TemporaryDirectory(prefix="agent-kit-") as tmp:
        out = Path(tmp) / "answer.md"
        if agent == "claude":
            cmd = [resolve_exe("claude"), "-p", prompt, "--output-format", "text", "--tools", ""]
        else:
            cmd = [resolve_exe("codex"), "exec", "--skip-git-repo-check", "--sandbox", "read-only",
                   "-o", str(out), prompt]
        r = subprocess.run(cmd, cwd=tmp, stdin=subprocess.DEVNULL, capture_output=True, text=True)
        if r.returncode != 0:
            raise InitError(f"{agent} exited with {r.returncode}: {r.stderr.strip()[-500:]}")
        return out.read_text() if agent == "codex" else r.stdout


def parse_rules_answer(answer, current):
    """Split the agent's answer into {lang: text} and check it kept the template intact."""
    answer = answer.split("=== end ===")[0]
    parts = re.split(r"^=== (\w+)\.md ===[ \t]*$", answer, flags=re.M)
    # tolerate a code fence around the whole answer
    found = {parts[i]: re.sub(r"\n```\s*$", "", parts[i + 1].strip("\n")) + "\n"
             for i in range(1, len(parts) - 1, 2)}
    missing = [lang for lang in current if lang not in found]
    if missing:
        raise InitError(f"agent answer has no section for {', '.join(missing)}.md; nothing written")
    for lang, old in current.items():
        new = found[lang]
        for ph in ("{{LANG_NAME}}", "{{CHAT_LANG_NAME}}", "{{DOCS_LANG_NAME}}", "{{GIT_LANG_NAME}}"):
            if ph in old and ph not in new:
                raise InitError(f"agent dropped {ph} from {lang}.md; nothing written")
        if new.splitlines()[0] != old.splitlines()[0]:
            raise InitError(f"agent changed the first heading of {lang}.md; nothing written")
    return {lang: found[lang] for lang in current}


def run_add_rule(args):
    scope = getattr(args, "scope", "global")
    repo_arg = getattr(args, "repo", None)
    if repo_arg and scope != "project":
        raise InitError("--repo requires --scope project; no rules were changed")
    if scope == "project":
        repo = git_root(Path(repo_arg or ".").expanduser().resolve())
        d = repo / ".agent-kit" / "rules"
        current = {lang: (project_rules_file(repo, lang).read_text()
                          if project_rules_file(repo, lang).exists() else PROJECT_RULE_HEADINGS[lang])
                   for lang in LANGS}
    else:
        d = user_rules_dir()
        current = {lang: rules_file(lang).read_text() for lang in LANGS}
    args.agent = select_agent(args.agent)
    prompt = (KIT / "prompts" / "add-rule.md").read_text().replace("{{RULE}}", args.rule.strip())
    prompt += "".join(f"=== {lang}.md ===\n{text.rstrip()}\n\n" for lang, text in current.items()) + "=== end ===\n"
    log(f"{args.agent}: writing the rule (this can take a minute)...")
    new = parse_rules_answer(ask_agent(args.agent, prompt), current)
    changed = [lang for lang in LANGS if new[lang] != current[lang]]
    if not changed:
        log("the agent changed nothing; the rule may already be covered")
        return 0
    for lang in changed:
        sys.stdout.writelines(difflib.unified_diff(
            current[lang].splitlines(True), new[lang].splitlines(True), f"a/{lang}.md", f"b/{lang}.md"))
    if args.dry_run:
        return 0
    if scope == "project":
        seed_project_rules(repo)
    else:
        seed_rules()
    for lang in changed:
        (d / f"{lang}.md").write_text(new[lang])
        log(f"rules: updated {d / f'{lang}.md'}")
    if scope == "project":
        log(f"apply it with: `agent-kit init {repo} --agent none`")
    else:
        log("apply it to your repos: `agent-kit sync ~/repos --check`, then without --check")
    return 0


def split_agents_md(text):
    """(head through the agent-kit block, project part, ai-memory block and after)."""
    i = text.index(END) + len(END)
    j = text.find(AI_MEMORY_START, i)
    j = len(text) if j < 0 else j
    return text[:i], text[i:j], text[j:]


def parse_sections(answer):
    m = re.search(r"^=== project sections ===[ \t]*$(.*?)^=== end ===", answer, flags=re.M | re.S)
    if not m:
        raise InitError("agent answer lacks the `=== project sections ===` / `=== end ===` delimiters; AGENTS.md left as is")
    body = re.sub(r"^\s*```\w*\n|\n```\s*$", "", m.group(1).strip("\n")).strip()
    if MARKER_RE.search(body):
        raise InitError("agent answer contains agent-kit/ai-memory markers; AGENTS.md left as is")
    if not re.search(r"^## ", body, flags=re.M):
        raise InitError("agent answer has no `## ` section; AGENTS.md left as is")
    return body


def suspicious_lines(old, new):
    """Added lines worth a human look: likely prompt-injection payloads."""
    added = [l[1:] for l in difflib.unified_diff(old.splitlines(), new.splitlines(), lineterm="")
             if l.startswith("+") and not l.startswith("+++")]
    return [l for l in added if SUSPICIOUS_RE.search(l)]


def generate_project_sections(repo, agent, docs_lang, migrate, trust):
    """Ask the read-only agent for validated project sections without writing the repository."""
    prompt = (KIT / "prompts" / "fill.md").read_text().replace("{{LANG_NAME}}", LANGS[docs_lang])
    if migrate:
        prompt += "\n" + (KIT / "prompts" / "migrate.md").read_text()
    with tempfile.TemporaryDirectory(prefix="agent-kit-") as tmp:
        out = Path(tmp) / "answer.md"
        if agent == "claude":
            cmd = [resolve_exe("claude"), "-p", prompt, "--output-format", "text",
                   "--tools", "Read", "Glob", "Grep", "Bash",
                   "--allowedTools", "Read", "Glob", "Grep",
                   "Bash(git log:*)", "Bash(git ls-files:*)", "Bash(ls:*)"]
            if not trust:
                # a cloned repo's .claude/settings.json hooks and .mcp.json servers must not run
                cmd += ["--setting-sources", "user", "--strict-mcp-config"]
        else:
            cmd = [resolve_exe("codex"), "exec", "--sandbox", "read-only", "-o", str(out), prompt]
        log(f"{agent}: analyzing the repo to fill project sections ({'trusted' if trust else 'read-only, project config ignored'}; this can take a minute)...")
        r = subprocess.run(cmd, cwd=repo, stdin=subprocess.DEVNULL, capture_output=True, text=True)
        if r.returncode != 0:
            raise InitError(f"{agent} exited with {r.returncode}: {r.stderr.strip()[-500:]}")
        answer = out.read_text() if agent == "codex" else r.stdout
    return parse_sections(answer)


def add_project_sections(ch, sections):
    """Add validated project sections to a pending Changes transaction."""
    f = ch.repo / "AGENTS.md"
    text = ch.read(f)
    head, old, tail = split_agents_md(text)
    new = f"{head}\n\n{sections}\n" + (f"\n{tail}" if tail else "")
    ch.write(f, new, "AGENTS.md: project sections written")
    return suspicious_lines(old, sections)


def find_repos(root, max_depth=3):
    """Git repositories under `root` (including itself), without descending into them."""
    found = []
    for dirpath, dirnames, _ in os.walk(root):
        path = Path(dirpath)
        if (path / ".git").exists():
            found.append(path)
            dirnames.clear()
            continue
        if len(path.relative_to(root).parts) >= max_depth:
            dirnames.clear()
        dirnames[:] = sorted(d for d in dirnames if not d.startswith(".") and d not in SKIP_DIRS)
    return found


def run_all(root, args):
    """Re-apply the deterministic part to every repo under `root` that already uses agent-kit."""
    checked = current = outdated = skipped = errors = 0
    for repo in find_repos(root):
        if not has_marker(repo):
            continue
        checked += 1
        name = os.path.relpath(repo, root)
        docs_lang, chat_lang, git_lang = saved_languages(repo)
        if not docs_lang:
            skipped += 1
            log(f"SKIP {name}: marker has no saved language; run `agent-kit init {repo} --docs-lang <pt|en>` once")
            continue
        chat_lang = chat_lang or docs_lang
        git_lang = git_lang or docs_lang
        try:
            ch = plan(repo, docs_lang, git_lang, chat_lang)
        except InitError as e:
            log(f"ERROR {name}: {e}")
            errors += 1
            continue
        if not ch.pending:
            current += 1
            if not args.check:
                log(f"ok {name}")
            continue
        outdated += 1
        if args.check:
            log(f"outdated {name}: " + ", ".join(ch.rel(p) for p in ch.pending))
        elif args.dry_run:
            ch.diff()
        else:
            log(f"updating {name}")
            ch.apply()
    changed_label = "outdated" if args.check else "would update" if args.dry_run else "updated"
    log(f"Checked {checked} repositories: {current} current, {outdated} {changed_label}, "
        f"{skipped} need migration, {errors} errors.")
    return 1 if errors or (args.check and (outdated or skipped)) else 0


def resolve_languages(repo, args):
    old_docs, old_chat, old_git = saved_languages(repo)
    if args.lang and (args.docs_lang or args.chat_lang):
        raise InitError("--lang cannot be combined with --docs-lang or --chat-lang")
    if args.lang:
        log("NOTE: --lang is the legacy alias for --docs-lang plus --chat-lang")
    docs_lang = args.docs_lang or args.lang or old_docs or "pt"
    chat_lang = args.chat_lang or args.lang or old_chat or docs_lang
    # Preserve the old --lang behavior for scripts: it also supplies the Git default.
    git_lang = args.git_lang or (args.lang if args.lang else old_git) or docs_lang
    return docs_lang, chat_lang, git_lang


def check_existing_claude(repo, args):
    path = repo / "CLAUDE.md"
    if not path.exists() or "@AGENTS.md" in path.read_text() or args.migrate_claude or args.keep_claude:
        return
    raise InitError(
        "CLAUDE.md exists but does not import AGENTS.md; no files were changed. "
        "Rerun with --migrate-claude, or --keep-claude to continue intentionally")


def run_one(repo, args):
    check_existing_claude(repo, args)
    requested_agent = args.agent or "auto"
    if args.migrate_claude and requested_agent == "none":
        raise InitError("--migrate-claude needs an agent to merge CLAUDE.md into AGENTS.md; drop --agent none")
    docs_lang, chat_lang, git_lang = resolve_languages(repo, args)
    ch = plan(repo, docs_lang, git_lang, chat_lang, args.tracked,
              args.hide_agent_files, args.migrate_claude, args.keep_claude)

    if args.check:
        if ch.pending:
            log("outdated: " + ", ".join(ch.rel(p) for p in ch.pending))
            return 1
        log("up to date")
        return 0
    if args.dry_run:
        ch.diff()
        steps = ["ai-memory install-instructions"]
        if requested_agent != "none":
            steps.append(f"{requested_agent} to fill project sections")
        if args.migrate_claude:
            steps.append("replace CLAUDE.md with the import stub if the agent succeeds")
        log("would also run: " + "; ".join(steps))
        return 0

    agent = select_agent(requested_agent)
    flagged = []
    if agent != "none":
        sections = generate_project_sections(repo, agent, docs_lang, args.migrate_claude, args.trust)
        flagged = add_project_sections(ch, sections)
    if args.migrate_claude:
        ch.write(repo / "CLAUDE.md", CLAUDE_MD, "CLAUDE.md: replaced with the import stub")
    if agent != "none" and ch.pending:
        ch.diff()
    ch.apply()
    install_ai_memory(repo, args.full_memory, not args.no_skills)
    if flagged:
        log("REVIEW: the agent wrote lines that run commands, fetch URLs or touch permissions; "
            "check they come from the project and not from injected text:")
        for line in flagged:
            log(f"  | {line.strip()}")
    log("done. Review with `git diff` / `git status`; nothing was committed.")
    return 0


def run_rules(args):
    scope = getattr(args, "scope", "global")
    repo_arg = getattr(args, "repo", None)
    if repo_arg and scope != "project":
        raise InitError("--repo requires --scope project")
    if scope == "project":
        repo = git_root(Path(repo_arg or ".").expanduser().resolve())
        created = []
        if getattr(args, "rules_command", None) == "init":
            created = seed_project_rules(repo)
        print("Global baseline:")
        for lang in LANGS:
            f = rules_file(lang)
            print(f"  {lang}: {f} ({'bundled' if f.parent == KIT / 'rules' else 'user'})")
        print("Project overlay:")
        for lang in LANGS:
            f = project_rules_file(repo, lang)
            print(f"  {lang}: {f} ({'project' if f.exists() else 'not created'})")
        if created:
            log("project rule overlays created")
            log(f"apply them with: `agent-kit init {repo} --agent none`")
    else:
        if getattr(args, "init", False) or getattr(args, "rules_command", None) == "init":
            seed_rules()
        print(f"user rules dir: {user_rules_dir()}")
        for lang in LANGS:
            f = rules_file(lang)
            print(f"{lang}: {f} ({'bundled' if f.parent == KIT / 'rules' else 'user'})")
    return 0


def procedure_path(directory, name):
    relative = Path(name)
    if relative.name in ("", ".", ".."):
        raise InitError("procedure name must identify a Markdown file")
    if relative.suffix == "":
        relative = relative.with_suffix(".md")
    elif relative.suffix.lower() != ".md":
        raise InitError("procedures must be Markdown files")
    if relative.is_absolute():
        raise InitError("procedure names must be relative to .agent-kit/procedures")
    candidate = (directory / relative).resolve()
    try:
        candidate.relative_to(directory.resolve())
    except ValueError:
        raise InitError("procedure names cannot leave .agent-kit/procedures")
    return candidate


def run_procedures(args):
    repo = git_root(Path(args.repo).expanduser().resolve())
    directory = procedures_dir(repo)
    command = args.procedures_command

    if command == "path":
        print(directory)
        return 0

    if command == "init":
        docs_lang, _, _ = saved_languages(repo)
        lang = args.docs_lang or docs_lang or "pt"
        readme = directory / "README.md"
        ch = Changes(repo)
        if not readme.exists():
            ch.write(readme, PROCEDURES_README[lang], "procedures: created .agent-kit/procedures/README.md")
        if args.check:
            if ch.pending:
                log("procedures not initialized")
                return 1
            log("procedures initialized")
            return 0
        if args.dry_run:
            ch.diff()
            return 0
        if not ch.pending:
            log("procedures already initialized")
            return 0
        ch.apply()
        log("add Markdown procedure files to .agent-kit/procedures/ and commit them with the project")
        return 0

    if command == "add":
        docs_lang, _, _ = saved_languages(repo)
        lang = args.docs_lang or docs_lang or "pt"
        path = procedure_path(directory, args.name)
        if path.name.lower() == "readme.md":
            raise InitError("README.md is reserved for the procedures index")
        relative_path = path.relative_to(directory.resolve())
        if path.exists():
            raise InitError(f"procedure already exists: {relative_path}")
        title = args.title or Path(args.name).stem.replace("-", " ").replace("_", " ").strip().title()
        if not title:
            raise InitError("procedure title cannot be empty")
        ch = Changes(repo)
        readme = directory / "README.md"
        if not readme.exists():
            ch.write(readme, PROCEDURES_README[lang], "procedures: created .agent-kit/procedures/README.md")
        ch.write(path, PROCEDURE_TEMPLATE[lang].format(title=title),
                 f"procedures: created {ch.rel(path)}")
        if args.dry_run:
            ch.diff()
            return 0
        ch.apply()
        log(f"edit {ch.rel(path)}, then commit it with the project")
        return 0

    if not directory.is_dir():
        raise InitError("project procedures are not initialized; run `agent-kit procedures init`")

    if command == "list":
        files = sorted(path.relative_to(directory) for path in directory.rglob("*.md")
                       if path.name != "README.md")
        if not files:
            log("no project procedures found")
            return 0
        for path in files:
            print(path.as_posix())
        return 0

    path = procedure_path(directory, args.name)
    if not path.is_file():
        raise InitError(f"procedure not found: {args.name}")
    text = path.read_text()
    print(text, end="" if text.endswith("\n") else "\n")
    return 0


def run_doctor(args):
    checks = {
        "git": shutil.which("git"),
        "claude": shutil.which("claude"),
        "codex": shutil.which("codex"),
        "ai-memory": shutil.which("ai-memory"),
    }
    for name, path in checks.items():
        print(f"{name}: {path or 'not found'}")
    print(f"rules: {user_rules_dir()}")
    if not checks["git"]:
        raise InitError("git is required")
    if not checks["claude"] and not checks["codex"]:
        log("WARNING: no agent found; init still works with --agent none")
    return 0


def git_root(path):
    if not path.is_dir():
        raise InitError(f"{path} is not a directory")
    r = subprocess.run(["git", "rev-parse", "--show-toplevel"], cwd=path,
                       capture_output=True, text=True)
    if r.returncode != 0:
        raise InitError(f"{path} is not inside a Git repository")
    return Path(r.stdout.strip()).resolve()


def tracked_paths(repo, paths):
    found = []
    for path in paths:
        r = subprocess.run(["git", "ls-files", "--error-unmatch", "--", path], cwd=repo,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if r.returncode == 0:
            found.append(path)
    return found


def apply_profile(repo, args):
    if args.profile == "upstream":
        if args.tracked:
            raise InitError("--profile upstream cannot be combined with --tracked")
        if args.trust:
            raise InitError("--profile upstream cannot be combined with --trust")
        args.hide_agent_files = True
        args.no_skills = True
    elif args.profile == "own":
        if args.hide_agent_files:
            raise InitError("--profile own cannot be combined with --hide-agent-files")
        args.tracked = True
    elif args.hide_agent_files:
        # The compatibility flag now fulfills its promise: all local artifacts stay hidden.
        args.no_skills = True
    if args.hide_agent_files:
        tracked = tracked_paths(repo, ["AGENTS.md", "CLAUDE.md", ".claude/settings.local.json"])
        if tracked:
            names = ", ".join(tracked)
            raise InitError(
                f"upstream tracks {names}, so local changes cannot be hidden; no files were changed. "
                "Use --profile own to modify tracked instructions, or continue without agent-kit")


def run_init(args):
    target = Path(args.repo).expanduser().resolve()
    if args.all:
        bad = [f for f, v in (("--lang", args.lang), ("--docs-lang", args.docs_lang),
                              ("--chat-lang", args.chat_lang), ("--git-lang", args.git_lang),
                              ("--profile", args.profile), ("--agent", args.agent),
                              ("--migrate-claude", args.migrate_claude), ("--full-memory", args.full_memory),
                              ("--tracked", args.tracked), ("--hide-agent-files", args.hide_agent_files),
                              ("--no-skills", args.no_skills), ("--trust", args.trust),
                              ("--keep-claude", args.keep_claude)) if v]
        if bad:
            raise InitError(f"--all only re-applies the deterministic part; not compatible with {', '.join(bad)}")
        if not target.is_dir():
            raise InitError(f"{target} is not a directory")
        return run_all(target, args)
    target = git_root(target)
    apply_profile(target, args)
    return run_one(target, args)


def run_sync(args):
    root = Path(args.root).expanduser().resolve()
    if not root.is_dir():
        raise InitError(f"{root} is not a directory")
    return run_all(root, args)


def build_parser():
    ap = argparse.ArgumentParser(prog="agent-kit", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--version", action="version", version=f"agent-kit {VERSION}")
    sub = ap.add_subparsers(dest="cmd", required=True)

    ip = sub.add_parser("init", help="set up or update a repository (what `agent-init` runs)")
    ip.add_argument("repo", nargs="?", default=".", help="target repository, or the root to scan with --all (default: current dir)")
    ip.add_argument("--profile", choices=["own", "upstream"],
                    help="safe defaults for your repository or a third-party clone")
    ip.add_argument("--chat-lang", choices=LANGS, help="language agents use to talk with you")
    ip.add_argument("--docs-lang", choices=LANGS, help="documentation and managed-rules language (default: saved value, else pt)")
    ip.add_argument("--git-lang", choices=LANGS, help="language of commits/issues/PRs (default: saved value, else docs language)")
    ip.add_argument("--lang", choices=LANGS, help="legacy alias for --chat-lang plus --docs-lang")
    ip.add_argument("--agent", choices=["auto", "claude", "codex", "none"],
                    help="who fills project sections (default: auto, Claude then Codex)")
    ip.add_argument("--full-memory", action="store_true", help="inline the full ai-memory guidance instead of --compact")
    ip.add_argument("--tracked", action="store_true", help="put .worktrees/ in the tracked .gitignore (your own repos) instead of .git/info/exclude")
    ip.add_argument("--hide-agent-files", action="store_true", help="also exclude AGENTS.md/CLAUDE.md locally (upstream forks)")
    claude_mode = ip.add_mutually_exclusive_group()
    claude_mode.add_argument("--migrate-claude", action="store_true", help="move an existing CLAUDE.md into AGENTS.md (via the agent) and replace it with the import stub")
    claude_mode.add_argument("--keep-claude", action="store_true", help="keep an independent existing CLAUDE.md intentionally")
    ip.add_argument("--no-skills", action="store_true", help="do not install ai-memory skills into the project")
    ip.add_argument("--trust", action="store_true", help="let the agent load the target repo's own Claude Code settings, hooks and MCP servers (your own repos only)")
    ip.add_argument("--all", action="store_true", help="re-apply the deterministic part to every agent-kit repo under REPO (keeps each repo's saved languages)")
    output = ip.add_mutually_exclusive_group()
    output.add_argument("--check", action="store_true", help="write nothing; list what is outdated and exit 1 if anything is")
    output.add_argument("--dry-run", action="store_true", help="write nothing; print the diff of what would change")
    ip.set_defaults(func=run_init)

    sp = sub.add_parser("sync", help="re-apply deterministic rules to existing agent-kit repositories")
    sp.add_argument("root", nargs="?", default=".", help="directory to scan (default: current dir)")
    sync_output = sp.add_mutually_exclusive_group()
    sync_output.add_argument("--check", action="store_true", help="write nothing; exit 1 if any repository needs attention")
    sync_output.add_argument("--dry-run", action="store_true", help="write nothing; print the diffs")
    sp.set_defaults(func=run_sync)

    rp = sub.add_parser("rules", help="show which rules files the managed block is built from")
    rp.add_argument("--init", action="store_true", help="legacy alias for `rules init`")
    rp.set_defaults(func=run_rules, scope="global", repo=None)
    rules_sub = rp.add_subparsers(dest="rules_command")
    rules_show = rules_sub.add_parser("show", help="show the active rule files")
    rules_show.add_argument("--scope", choices=["global", "project"], default="global",
                            help="global personal baseline (default) or tracked project overlay")
    rules_show.add_argument("--repo", help="target repository; requires --scope project")
    rules_show.set_defaults(func=run_rules)
    rules_init = rules_sub.add_parser("init", help="seed rule files without overwriting")
    rules_init.add_argument("--scope", choices=["global", "project"], default="global",
                            help="global personal baseline (default) or tracked project overlay")
    rules_init.add_argument("--repo", help="target repository; requires --scope project")
    rules_init.set_defaults(func=run_rules)
    rules_add = rules_sub.add_parser("add", help="have a local agent add a rule in every language")
    rules_add.add_argument("rule", help="the rule, in any language")
    rules_add.add_argument("--agent", choices=["auto", "claude", "codex"], default="auto")
    rules_add.add_argument("--scope", choices=["global", "project"], default="global",
                           help="global personal baseline (default) or tracked project overlay")
    rules_add.add_argument("--repo", help="target repository; requires --scope project")
    rules_add.add_argument("--dry-run", action="store_true", help="print the diff, write nothing")
    rules_add.set_defaults(func=run_add_rule)

    pp = sub.add_parser("procedures", help="manage AI-agnostic procedures stored with the project")
    procedures_sub = pp.add_subparsers(dest="procedures_command", required=True)
    procedures_path = procedures_sub.add_parser("path", help="print the project procedures directory")
    procedures_path.add_argument("repo", nargs="?", default=".", help="target repository")
    procedures_path.set_defaults(func=run_procedures)
    procedures_init = procedures_sub.add_parser("init", help="create the project procedures directory")
    procedures_init.add_argument("repo", nargs="?", default=".", help="target repository")
    procedures_init.add_argument("--docs-lang", choices=LANGS,
                                 help="README language (default: saved docs language, else pt)")
    procedures_output = procedures_init.add_mutually_exclusive_group()
    procedures_output.add_argument("--check", action="store_true",
                                   help="write nothing; exit 1 if procedures are not initialized")
    procedures_output.add_argument("--dry-run", action="store_true",
                                   help="write nothing; print the README diff")
    procedures_init.set_defaults(func=run_procedures)
    procedures_add = procedures_sub.add_parser("add", help="create a Markdown procedure template")
    procedures_add.add_argument("name", help="procedure name or relative Markdown path")
    procedures_add.add_argument("repo", nargs="?", default=".", help="target repository")
    procedures_add.add_argument("--title", help="document title (default: derived from the name)")
    procedures_add.add_argument("--docs-lang", choices=LANGS,
                                help="template language (default: saved docs language, else pt)")
    procedures_add.add_argument("--dry-run", action="store_true",
                                help="write nothing; print the README and procedure diff")
    procedures_add.set_defaults(func=run_procedures)
    procedures_list = procedures_sub.add_parser("list", help="list project procedure files")
    procedures_list.add_argument("repo", nargs="?", default=".", help="target repository")
    procedures_list.set_defaults(func=run_procedures)
    procedures_show = procedures_sub.add_parser("show", help="print a project procedure")
    procedures_show.add_argument("name", help="procedure name or relative Markdown path")
    procedures_show.add_argument("repo", nargs="?", default=".", help="target repository")
    procedures_show.set_defaults(func=run_procedures)

    ap_add = sub.add_parser("add-rule", help="have a local agent add a rule to your rules files (all languages)")
    ap_add.add_argument("rule", help="the rule, in any language, e.g. \"never push without asking\"")
    ap_add.add_argument("--agent", choices=["auto", "claude", "codex"], default="auto",
                        help="local agent CLI to use (default: auto, Claude then Codex)")
    ap_add.add_argument("--scope", choices=["global", "project"], default="global",
                        help="global personal baseline (default) or tracked project overlay")
    ap_add.add_argument("--repo", help="target repository; requires --scope project")
    ap_add.add_argument("--dry-run", action="store_true", help="print the diff, write nothing")
    ap_add.set_defaults(func=run_add_rule)

    sub.add_parser("doctor", help="check required and optional local tools").set_defaults(func=run_doctor)
    return ap


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if Path(sys.argv[0]).name == "agent-init" and argv != ["--version"]:
        argv = ["init", *argv]
    args = build_parser().parse_args(argv)
    try:
        return args.func(args)
    except InitError as e:
        print(f"agent-kit: error: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
