#!/usr/bin/env python3
"""Thin executable entry point for agent-kit."""

import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

# Compatibility exports for callers that historically loaded this extensionless script.
from agent_kit import *  # noqa: E402,F401,F403
from agent_kit.cli import build_parser, main  # noqa: E402,F401


if __name__ == "__main__":
    sys.exit(main())
